>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CBTEST.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT SAMPLE ASSIGN TO "cbtest.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS SAMPLE-FS.
DATA DIVISION.
FILE SECTION.
FD SAMPLE.
01 SAMPLE-REC PIC X(297).
WORKING-STORAGE SECTION.
COPY cbconst.
COPY cbrequest.
01 SAMPLE-FS PIC XX.
01 FAILURES PIC 9(4) VALUE 0.
01 EXPECTED PIC 9(4).
01 SAVED-HASH PIC X(64).
01 SAVED-LEN PIC 9(4).
01 SENT PIC X(128).
01 MORE-FLAG PIC X VALUE "N".
    88 MORE-LINES VALUE "Y".
01 LINE-COUNT PIC 9.
01 LINE-SLOT OCCURS 8 PIC X(297).
01 FLIP PIC X.

PROCEDURE DIVISION.
MAIN-LOGIC.
    PERFORM REJECT-BAD-CALLS
    PERFORM EXERCISE-LEDGER
    IF FAILURES = 0
        DISPLAY "CBTEST OK"
        MOVE 0 TO RETURN-CODE
    ELSE
        DISPLAY "CBTEST NG " FAILURES
        MOVE 1 TO RETURN-CODE
    END-IF
    STOP RUN
    .

REJECT-BAD-CALLS.
    PERFORM ZERO-REQUEST
    MOVE LOW-VALUES TO CB-REQUEST(1:2)
    MOVE 11 TO CB-PATH-LEN
    MOVE "cbtest.dat" TO CB-PATH
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-FUNC TO EXPECTED
    PERFORM EXPECT-STATUS

    PERFORM ZERO-REQUEST
    MOVE CB-FN-INIT TO CB-FUNC
    MOVE 9 TO CB-OPTIONS
    MOVE 11 TO CB-PATH-LEN
    MOVE "cbtest.dat" TO CB-PATH
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-ARGUMENT TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-DETAIL NOT = CB-WHY-OPTIONS
        ADD 1 TO FAILURES
        DISPLAY "NG options detail=" CB-DETAIL
    END-IF

    PERFORM ZERO-REQUEST
    MOVE CB-FN-COUNT TO CB-FUNC
    MOVE 0 TO CB-PATH-LEN
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-ARGUMENT TO EXPECTED
    PERFORM EXPECT-STATUS
    .

EXERCISE-LEDGER.
    PERFORM ZERO-REQUEST
    MOVE CB-FN-INIT TO CB-FUNC
    MOVE CB-OPT-REPLACE TO CB-OPTIONS
    MOVE 14 TO CB-PATH-LEN
    MOVE "cbdefault.dat" TO CB-PATH
    MOVE "GENESIS" TO CB-DATA
    MOVE 7 TO CB-DATA-LEN
    MOVE 0 TO CB-DIFFICULTY
    MOVE "20261105100000" TO CB-TIMESTAMP
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-DIFFICULTY NOT = CB-DEFAULT-DIFF
        OR CB-HASH(1:2) NOT = "00"
        OR CB-INDEX NOT = 0
        ADD 1 TO FAILURES
        DISPLAY "NG default difficulty"
    END-IF

    PERFORM ZERO-REQUEST
    MOVE CB-FN-INIT TO CB-FUNC
    MOVE CB-OPT-REPLACE TO CB-OPTIONS
    MOVE 8 TO CB-DIFFICULTY
    MOVE 5 TO CB-MAX-NONCE
    MOVE 10 TO CB-PATH-LEN
    MOVE "cbpow.dat" TO CB-PATH
    MOVE "NO" TO CB-DATA
    MOVE 2 TO CB-DATA-LEN
    MOVE "20261105100000" TO CB-TIMESTAMP
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-POW TO EXPECTED
    PERFORM EXPECT-STATUS
    MOVE CB-FN-COUNT TO CB-FUNC
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-NOT-FOUND TO EXPECTED
    PERFORM EXPECT-STATUS

    PERFORM FILL-TEST-PATH
    MOVE CB-FN-INIT TO CB-FUNC
    MOVE CB-OPT-REPLACE TO CB-OPTIONS
    MOVE 1 TO CB-DIFFICULTY
    MOVE "GENESIS" TO CB-DATA
    MOVE 7 TO CB-DATA-LEN
    MOVE "20261105120000" TO CB-TIMESTAMP
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS
    MOVE CB-HASH TO SAVED-HASH

    MOVE CB-OPT-NONE TO CB-OPTIONS
    MOVE CB-FN-INIT TO CB-FUNC
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-EXISTS TO EXPECTED
    PERFORM EXPECT-STATUS

    PERFORM FILL-TEST-PATH
    MOVE CB-FN-APPEND TO CB-FUNC
    MOVE "alpha" TO CB-DATA
    MOVE 5 TO CB-DATA-LEN
    MOVE "20261105120001" TO CB-TIMESTAMP
    MOVE 0 TO CB-DIFFICULTY
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-INDEX NOT = 1 OR CB-PREV NOT = SAVED-HASH
        OR CB-BDATA(1:5) NOT = "alpha" OR CB-BLEN NOT = 5
        ADD 1 TO FAILURES
        DISPLAY "NG append alpha"
    END-IF

    MOVE SPACES TO CB-DATA
    MOVE "A B" TO CB-DATA
    MOVE 3 TO CB-DATA-LEN
    MOVE "20261105120002" TO CB-TIMESTAMP
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS

    MOVE SPACES TO SENT
    MOVE "太郎" TO SENT
    PERFORM VARYING SAVED-LEN FROM FUNCTION LENGTH(SENT) BY -1
        UNTIL SAVED-LEN = 0
        IF SENT(SAVED-LEN:1) NOT = SPACE
            EXIT PERFORM
        END-IF
    END-PERFORM
    MOVE SPACES TO CB-DATA
    MOVE SENT(1:SAVED-LEN) TO CB-DATA
    MOVE SAVED-LEN TO CB-DATA-LEN
    MOVE "20261105120003" TO CB-TIMESTAMP
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS

    MOVE CB-FN-COUNT TO CB-FUNC
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-COUNT NOT = 4 OR CB-DIFFICULTY NOT = 1
        ADD 1 TO FAILURES
        DISPLAY "NG count=" CB-COUNT
    END-IF

    MOVE CB-FN-GET TO CB-FUNC
    MOVE 2 TO CB-INDEX
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-BLEN NOT = 3 OR CB-BDATA(1:3) NOT = "A B"
        ADD 1 TO FAILURES
        DISPLAY "NG get spaced data"
    END-IF

    MOVE CB-FN-GET TO CB-FUNC
    MOVE 3 TO CB-INDEX
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-BLEN NOT = SAVED-LEN
        OR CB-BDATA(1:SAVED-LEN) NOT = SENT(1:SAVED-LEN)
        ADD 1 TO FAILURES
        DISPLAY "NG get multibyte"
    END-IF

    MOVE 99 TO CB-INDEX
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-RANGE TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-DETAIL NOT = 4
        ADD 1 TO FAILURES
        DISPLAY "NG range detail=" CB-DETAIL
    END-IF

    MOVE CB-FN-LAST TO CB-FUNC
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-INDEX NOT = 3 OR CB-COUNT NOT = 4
        ADD 1 TO FAILURES
        DISPLAY "NG last"
    END-IF

    MOVE CB-FN-VERIFY TO CB-FUNC
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-OK TO EXPECTED
    PERFORM EXPECT-STATUS

    MOVE CB-FN-APPEND TO CB-FUNC
    MOVE 2 TO CB-DIFFICULTY
    MOVE "nope" TO CB-DATA
    MOVE 4 TO CB-DATA-LEN
    MOVE "20261105120004" TO CB-TIMESTAMP
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-DIFFICULTY TO EXPECTED
    PERFORM EXPECT-STATUS

    MOVE 0 TO CB-DATA-LEN
    MOVE 0 TO CB-DIFFICULTY
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-ARGUMENT TO EXPECTED
    PERFORM EXPECT-STATUS

    MOVE 4 TO CB-DATA-LEN
    MOVE "ABCD" TO CB-TIMESTAMP
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-ARGUMENT TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-DETAIL NOT = CB-WHY-TIMESTAMP
        ADD 1 TO FAILURES
        DISPLAY "NG timestamp detail=" CB-DETAIL
    END-IF

    PERFORM LOAD-LINES
    IF LINE-COUNT < 3
        ADD 1 TO FAILURES
        DISPLAY "NG sample lines=" LINE-COUNT
        EXIT PARAGRAPH
    END-IF
    MOVE LINE-SLOT(3)(25:1) TO FLIP
    IF FLIP = "a"
        MOVE "b" TO LINE-SLOT(3)(25:1)
    ELSE
        MOVE "a" TO LINE-SLOT(3)(25:1)
    END-IF
    PERFORM STORE-LINES
    PERFORM FILL-TEST-PATH
    MOVE CB-FN-VERIFY TO CB-FUNC
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-LINK TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-DETAIL NOT = 1
        ADD 1 TO FAILURES
        DISPLAY "NG link detail=" CB-DETAIL
    END-IF

    MOVE FLIP TO LINE-SLOT(3)(25:1)
    MOVE LINE-SLOT(2)(94:1) TO FLIP
    IF FLIP = "X"
        MOVE "Y" TO LINE-SLOT(2)(94:1)
    ELSE
        MOVE "X" TO LINE-SLOT(2)(94:1)
    END-IF
    PERFORM STORE-LINES
    PERFORM FILL-TEST-PATH
    MOVE CB-FN-VERIFY TO CB-FUNC
    CALL "CBCHAIN" USING CB-REQUEST
    MOVE CB-ERR-HASH TO EXPECTED
    PERFORM EXPECT-STATUS
    IF CB-DETAIL NOT = 0
        ADD 1 TO FAILURES
        DISPLAY "NG hash detail=" CB-DETAIL
    END-IF
    .

FILL-TEST-PATH.
    PERFORM ZERO-REQUEST
    MOVE 10 TO CB-PATH-LEN
    MOVE "cbtest.dat" TO CB-PATH
    .

ZERO-REQUEST.
    MOVE 0 TO CB-FUNC
    MOVE 0 TO CB-OPTIONS
    MOVE 0 TO CB-STATUS
    MOVE 0 TO CB-DETAIL
    MOVE 0 TO CB-PATH-LEN
    MOVE 0 TO CB-DATA-LEN
    MOVE 0 TO CB-DIFFICULTY
    MOVE 0 TO CB-MAX-NONCE
    MOVE 0 TO CB-COUNT
    MOVE 0 TO CB-INDEX
    MOVE 0 TO CB-BLEN
    MOVE 0 TO CB-NONCE
    MOVE "00" TO CB-FS
    MOVE SPACES TO CB-PATH
    MOVE SPACES TO CB-DATA
    MOVE SPACES TO CB-TIMESTAMP
    MOVE SPACES TO CB-TIME
    MOVE SPACES TO CB-PREV
    MOVE SPACES TO CB-BDATA
    MOVE SPACES TO CB-HASH
    .

EXPECT-STATUS.
    IF CB-STATUS NOT = EXPECTED
        ADD 1 TO FAILURES
        DISPLAY "NG status=" CB-STATUS " expected=" EXPECTED
            " detail=" CB-DETAIL " fs=" CB-FS
    END-IF
    .

LOAD-LINES.
    MOVE 0 TO LINE-COUNT
    OPEN INPUT SAMPLE
    IF SAMPLE-FS NOT = "00"
        DISPLAY "NG open read " SAMPLE-FS
        ADD 1 TO FAILURES
        EXIT PARAGRAPH
    END-IF
    PERFORM UNTIL LINE-COUNT >= 8
        READ SAMPLE
            AT END
                EXIT PERFORM
            NOT AT END
                ADD 1 TO LINE-COUNT
                MOVE SAMPLE-REC TO LINE-SLOT(LINE-COUNT)
        END-READ
    END-PERFORM
    CLOSE SAMPLE
    .

STORE-LINES.
    OPEN OUTPUT SAMPLE
    IF SAMPLE-FS NOT = "00"
        DISPLAY "NG open write " SAMPLE-FS
        ADD 1 TO FAILURES
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING SAVED-LEN FROM 1 BY 1 UNTIL SAVED-LEN > LINE-COUNT
        MOVE LINE-SLOT(SAVED-LEN) TO SAMPLE-REC
        WRITE SAMPLE-REC
    END-PERFORM
    CLOSE SAMPLE
    .

END PROGRAM CBTEST.
