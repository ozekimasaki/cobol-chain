>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. SHA256.

*> FIPS 180-4 SHA-256。
*> メッセージは 440 バイトまで。結果は小文字 16 進 64 桁。
*> ビット演算は COBOL の標準ライブラリ呼び出し CBL_XOR / CBL_AND / CBL_NOT。
DATA DIVISION.
WORKING-STORAGE SECTION.
01 READY-FLAG PIC X VALUE "N".
01 HEXD PIC X(16) VALUE "0123456789abcdef".
01 K-HEX PIC X(512) VALUE
    "428a2f9871374491b5c0fbcfe9b5dba53956c25b59f111f1923f82a4ab1c5ed5" &
    "d807aa9812835b01243185be550c7dc372be5d7480deb1fe9bdc06a7c19bf174" &
    "e49b69c1efbe47860fc19dc6240ca1cc2de92c6f4a7484aa5cb0a9dc76f988da" &
    "983e5152a831c66db00327c8bf597fc7c6e00bf3d5a7914706ca635114292967" &
    "27b70a852e1b21384d2c6dfc53380d13650a7354766a0abb81c2c92e92722c85" &
    "a2bfe8a1a81a664bc24b8b70c76c51a3d192e819d6990624f40e3585106aa070" &
    "19a4c1161e376c082748774c34b0bcb5391c0cb34ed8aa4a5b9cca4f682e6ff3" &
    "748f82ee78a5636f84c878148cc7020890befffaa4506cebbef9a3f7c67178f2".
01 H-HEX PIC X(64) VALUE
    "6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19".

01 P2-TABLE.
    05 P2 OCCURS 33 USAGE BINARY-DOUBLE UNSIGNED.
01 K-TABLE.
    05 K-VAL OCCURS 64 USAGE BINARY-DOUBLE UNSIGNED.
01 H-INIT-TABLE.
    05 H-INIT OCCURS 8 USAGE BINARY-DOUBLE UNSIGNED.
01 H-CUR-TABLE.
    05 H-CUR OCCURS 8 USAGE BINARY-DOUBLE UNSIGNED.
01 SCHEDULE.
    05 W-WORD OCCURS 64 USAGE BINARY-DOUBLE UNSIGNED.

01 PAD PIC X(512).
01 PAD-LEN PIC 9(4).
01 MSG-LEN PIC 9(4).
01 CHUNK-OFF PIC 9(4).
01 BYTE-POS PIC 9(4).
01 HEX-AT PIC 9(4).
01 LEN-AT PIC 9(4).
01 TOTAL PIC 9(4).
01 REMN PIC 9(4).
01 ZERO-N PIC 9(4).
01 I PIC 99.
01 J PIC 99.
01 SHIFT PIC 99.
01 HP PIC 999.
01 HI PIC 99.
01 LO PIC 99.
01 NIB PIC 99.
01 BYTE-VAL PIC 999.
01 B1 PIC 999.
01 B2 PIC 999.
01 B3 PIC 999.
01 B4 PIC 999.
01 DIG PIC X.
01 HEX8 PIC X(8).
01 BYTE-A PIC X(4).
01 BIT-A USAGE BINARY-LONG UNSIGNED.
01 BIT-B USAGE BINARY-LONG UNSIGNED.

01 BITLEN USAGE BINARY-DOUBLE UNSIGNED.
01 WA USAGE BINARY-DOUBLE UNSIGNED.
01 WB USAGE BINARY-DOUBLE UNSIGNED.
01 WR USAGE BINARY-DOUBLE UNSIGNED.
01 DIVISOR USAGE BINARY-DOUBLE UNSIGNED.
01 FACTOR USAGE BINARY-DOUBLE UNSIGNED.
01 VA USAGE BINARY-DOUBLE UNSIGNED.
01 VB USAGE BINARY-DOUBLE UNSIGNED.
01 VC USAGE BINARY-DOUBLE UNSIGNED.
01 VD USAGE BINARY-DOUBLE UNSIGNED.
01 VE USAGE BINARY-DOUBLE UNSIGNED.
01 VF USAGE BINARY-DOUBLE UNSIGNED.
01 VG USAGE BINARY-DOUBLE UNSIGNED.
01 VH USAGE BINARY-DOUBLE UNSIGNED.
01 SIG0 USAGE BINARY-DOUBLE UNSIGNED.
01 SIG1 USAGE BINARY-DOUBLE UNSIGNED.
01 CHV USAGE BINARY-DOUBLE UNSIGNED.
01 MAJ USAGE BINARY-DOUBLE UNSIGNED.
01 TEMP1 USAGE BINARY-DOUBLE UNSIGNED.
01 TEMP2 USAGE BINARY-DOUBLE UNSIGNED.
01 T1 USAGE BINARY-DOUBLE UNSIGNED.

LINKAGE SECTION.
01 L-MSG PIC X(440).
01 L-LEN PIC 9(4).
01 L-HEX PIC X(64).

PROCEDURE DIVISION USING L-MSG L-LEN L-HEX.
MAIN-LOGIC.
    IF READY-FLAG NOT = "Y"
        PERFORM INIT-TABLES
        MOVE "Y" TO READY-FLAG
    END-IF
    IF L-LEN > 440
        MOVE ALL "!" TO L-HEX
        GOBACK
    END-IF
    PERFORM RESET-STATE
    PERFORM PAD-MESSAGE
    PERFORM PROCESS-ALL
    PERFORM EMIT-HEX
    GOBACK
    .

INIT-TABLES.
    MOVE 1 TO P2(1)
    PERFORM VARYING I FROM 2 BY 1 UNTIL I > 33
        COMPUTE P2(I) = P2(I - 1) * 2
    END-PERFORM
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 64
        COMPUTE HEX-AT = (I - 1) * 8 + 1
        MOVE K-HEX(HEX-AT:8) TO HEX8
        PERFORM HEX8-TO-WORD
        MOVE WR TO K-VAL(I)
    END-PERFORM
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 8
        COMPUTE HEX-AT = (I - 1) * 8 + 1
        MOVE H-HEX(HEX-AT:8) TO HEX8
        PERFORM HEX8-TO-WORD
        MOVE WR TO H-INIT(I)
    END-PERFORM
    .

RESET-STATE.
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 8
        MOVE H-INIT(I) TO H-CUR(I)
    END-PERFORM
    MOVE ALL X"00" TO PAD
    .

PAD-MESSAGE.
    MOVE L-LEN TO MSG-LEN
    IF MSG-LEN > 0
        MOVE L-MSG(1:MSG-LEN) TO PAD(1:MSG-LEN)
    END-IF
    COMPUTE BYTE-POS = MSG-LEN + 1
    MOVE X"80" TO PAD(BYTE-POS:1)
    COMPUTE TOTAL = MSG-LEN + 9
    COMPUTE REMN = FUNCTION MOD(TOTAL, 64)
    COMPUTE ZERO-N = FUNCTION MOD(64 - REMN, 64)
    COMPUTE PAD-LEN = MSG-LEN + 1 + ZERO-N + 8
    COMPUTE BITLEN = MSG-LEN * 8
    MOVE BITLEN TO WA
    PERFORM EXPORT-WORD
    COMPUTE LEN-AT = PAD-LEN - 3
    MOVE BYTE-A TO PAD(LEN-AT:4)
    .

PROCESS-ALL.
    PERFORM VARYING CHUNK-OFF FROM 1 BY 64 UNTIL CHUNK-OFF > PAD-LEN
        PERFORM PROCESS-CHUNK
    END-PERFORM
    .

PROCESS-CHUNK.
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 16
        COMPUTE BYTE-POS = CHUNK-OFF + (I - 1) * 4
        MOVE PAD(BYTE-POS:4) TO BYTE-A
        PERFORM IMPORT-WORD
        MOVE WR TO W-WORD(I)
    END-PERFORM
    PERFORM VARYING I FROM 17 BY 1 UNTIL I > 64
        MOVE W-WORD(I - 15) TO WA
        MOVE 7 TO SHIFT
        PERFORM ROTR-OP
        MOVE WR TO T1
        MOVE W-WORD(I - 15) TO WA
        MOVE 18 TO SHIFT
        PERFORM ROTR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO T1
        MOVE W-WORD(I - 15) TO WA
        MOVE 3 TO SHIFT
        PERFORM SHR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO SIG0

        MOVE W-WORD(I - 2) TO WA
        MOVE 17 TO SHIFT
        PERFORM ROTR-OP
        MOVE WR TO T1
        MOVE W-WORD(I - 2) TO WA
        MOVE 19 TO SHIFT
        PERFORM ROTR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO T1
        MOVE W-WORD(I - 2) TO WA
        MOVE 10 TO SHIFT
        PERFORM SHR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO SIG1

        COMPUTE W-WORD(I) = FUNCTION MOD(
            W-WORD(I - 16) + SIG0 + W-WORD(I - 7) + SIG1,
            4294967296)
    END-PERFORM

    MOVE H-CUR(1) TO VA
    MOVE H-CUR(2) TO VB
    MOVE H-CUR(3) TO VC
    MOVE H-CUR(4) TO VD
    MOVE H-CUR(5) TO VE
    MOVE H-CUR(6) TO VF
    MOVE H-CUR(7) TO VG
    MOVE H-CUR(8) TO VH
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 64
        MOVE VE TO WA
        MOVE 6 TO SHIFT
        PERFORM ROTR-OP
        MOVE WR TO T1
        MOVE VE TO WA
        MOVE 11 TO SHIFT
        PERFORM ROTR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO T1
        MOVE VE TO WA
        MOVE 25 TO SHIFT
        PERFORM ROTR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO SIG1

        MOVE VE TO WA
        MOVE VF TO WB
        PERFORM AND-OP
        MOVE WR TO T1
        MOVE VE TO WA
        PERFORM NOT-OP
        MOVE WR TO WA
        MOVE VG TO WB
        PERFORM AND-OP
        MOVE WR TO WB
        MOVE T1 TO WA
        PERFORM XOR-OP
        MOVE WR TO CHV

        COMPUTE TEMP1 = FUNCTION MOD(
            VH + SIG1 + CHV + K-VAL(I) + W-WORD(I),
            4294967296)

        MOVE VA TO WA
        MOVE 2 TO SHIFT
        PERFORM ROTR-OP
        MOVE WR TO T1
        MOVE VA TO WA
        MOVE 13 TO SHIFT
        PERFORM ROTR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO T1
        MOVE VA TO WA
        MOVE 22 TO SHIFT
        PERFORM ROTR-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO SIG0

        MOVE VA TO WA
        MOVE VB TO WB
        PERFORM AND-OP
        MOVE WR TO T1
        MOVE VA TO WA
        MOVE VC TO WB
        PERFORM AND-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO T1
        MOVE VB TO WA
        MOVE VC TO WB
        PERFORM AND-OP
        MOVE T1 TO WA
        MOVE WR TO WB
        PERFORM XOR-OP
        MOVE WR TO MAJ

        COMPUTE TEMP2 = FUNCTION MOD(SIG0 + MAJ, 4294967296)
        MOVE VG TO VH
        MOVE VF TO VG
        MOVE VE TO VF
        COMPUTE VE = FUNCTION MOD(VD + TEMP1, 4294967296)
        MOVE VC TO VD
        MOVE VB TO VC
        MOVE VA TO VB
        COMPUTE VA = FUNCTION MOD(TEMP1 + TEMP2, 4294967296)
    END-PERFORM
    COMPUTE H-CUR(1) = FUNCTION MOD(H-CUR(1) + VA, 4294967296)
    COMPUTE H-CUR(2) = FUNCTION MOD(H-CUR(2) + VB, 4294967296)
    COMPUTE H-CUR(3) = FUNCTION MOD(H-CUR(3) + VC, 4294967296)
    COMPUTE H-CUR(4) = FUNCTION MOD(H-CUR(4) + VD, 4294967296)
    COMPUTE H-CUR(5) = FUNCTION MOD(H-CUR(5) + VE, 4294967296)
    COMPUTE H-CUR(6) = FUNCTION MOD(H-CUR(6) + VF, 4294967296)
    COMPUTE H-CUR(7) = FUNCTION MOD(H-CUR(7) + VG, 4294967296)
    COMPUTE H-CUR(8) = FUNCTION MOD(H-CUR(8) + VH, 4294967296)
    .

EMIT-HEX.
    MOVE 0 TO HP
    PERFORM VARYING I FROM 1 BY 1 UNTIL I > 8
        MOVE H-CUR(I) TO WA
        PERFORM EXPORT-WORD
        PERFORM VARYING J FROM 1 BY 1 UNTIL J > 4
            COMPUTE BYTE-VAL = FUNCTION ORD(BYTE-A(J:1)) - 1
            COMPUTE HI = BYTE-VAL / 16 + 1
            COMPUTE LO = FUNCTION MOD(BYTE-VAL, 16) + 1
            ADD 1 TO HP
            MOVE HEXD(HI:1) TO L-HEX(HP:1)
            ADD 1 TO HP
            MOVE HEXD(LO:1) TO L-HEX(HP:1)
        END-PERFORM
    END-PERFORM
    .

HEX8-TO-WORD.
    MOVE 0 TO WR
    PERFORM VARYING J FROM 1 BY 1 UNTIL J > 8
        MOVE HEX8(J:1) TO DIG
        MOVE 0 TO NIB
        INSPECT HEXD TALLYING NIB
            FOR CHARACTERS BEFORE INITIAL DIG
        COMPUTE WR = WR * 16 + NIB
    END-PERFORM
    .

EXPORT-WORD.
    COMPUTE B1 = WA / 16777216
    COMPUTE B2 = FUNCTION MOD(WA / 65536, 256)
    COMPUTE B3 = FUNCTION MOD(WA / 256, 256)
    COMPUTE B4 = FUNCTION MOD(WA, 256)
    MOVE FUNCTION CHAR(B1 + 1) TO BYTE-A(1:1)
    MOVE FUNCTION CHAR(B2 + 1) TO BYTE-A(2:1)
    MOVE FUNCTION CHAR(B3 + 1) TO BYTE-A(3:1)
    MOVE FUNCTION CHAR(B4 + 1) TO BYTE-A(4:1)
    .

IMPORT-WORD.
    COMPUTE WR =
        (FUNCTION ORD(BYTE-A(1:1)) - 1) * 16777216
        + (FUNCTION ORD(BYTE-A(2:1)) - 1) * 65536
        + (FUNCTION ORD(BYTE-A(3:1)) - 1) * 256
        + (FUNCTION ORD(BYTE-A(4:1)) - 1)
    .

*> 入力 WA と SHIFT。出力 WR。WA は保持する。
ROTR-OP.
    COMPUTE DIVISOR = P2(SHIFT + 1)
    COMPUTE FACTOR = P2(33 - SHIFT)
    COMPUTE WR = FUNCTION MOD(
        (WA / DIVISOR)
        + FUNCTION MOD(WA, DIVISOR) * FACTOR,
        4294967296)
    .

SHR-OP.
    COMPUTE WR = WA / P2(SHIFT + 1)
    .

*> 入力 WA と WB。出力 WR。
XOR-OP.
    MOVE WA TO BIT-A
    MOVE WB TO BIT-B
    CALL "CBL_XOR" USING BIT-A BIT-B BY VALUE 4
    MOVE BIT-B TO WR
    .

AND-OP.
    MOVE WA TO BIT-A
    MOVE WB TO BIT-B
    CALL "CBL_AND" USING BIT-A BIT-B BY VALUE 4
    MOVE BIT-B TO WR
    .

NOT-OP.
    MOVE WA TO BIT-A
    CALL "CBL_NOT" USING BIT-A BY VALUE 4
    MOVE BIT-A TO WR
    .

END PROGRAM SHA256.
